{
  "name": "projeto-teste-mobile",
  "version": "1.0.0",
  "description": "Projeto de teste mobile",
  "author": "Leonardo Paixão",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "appium --config .appiumrc.json",
    "clean:allure": "rimraf allure-results",
    "test:all": "yarn clean:allure && yarn test:demoapp && yarn test:productapp && yarn relatory",
    "test:demoapp": "cross-env APP_ENV=demoapp wdio run ./wdio.conf.ts --spec",
    "test:productapp": "cross-env APP_ENV=productapp wdio run ./wdio.conf.ts --spec",
    "relatory": "allure generate allure-results --clean",
    "relatory:open": "allure open",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "keywords": [
    "appium",
    "test",
    "mobile"
  ],
  "dependencies": {
    "@wdio/cli": "9.21.0",
    "dotenv": "17.2.3",
    "rimraf": "6.0.1",
    "webdriverio": "9.21.0"
  },
  "devDependencies": {
    "@appium/images-plugin": "4.0.4",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@babel/cli": "7.28.3",
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@types/node": "22.10.0",
    "@wdio/allure-reporter": "9.21.0",
    "@wdio/appium-service": "9.21.0",
    "@wdio/globals": "9.17.0",
    "@wdio/local-runner": "9.21.0",
    "@wdio/logger": "9.18.0",
    "@wdio/mocha-framework": "9.21.0",
    "allure-commandline": "2.36.0",
    "appium": "3.1.2",
    "appium-gestures-plugin": "5.0.0",
    "appium-uiautomator2-driver": "6.7.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.7.4",
    "expect-webdriverio": "5.5.0",
    "lodash": "4.17.21",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.18.2",
    "typescript": "5.7.3"
  }
}
